---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  detail: string;
  sizes: string;
  widths: number[];
  pending?: boolean | undefined;
}

const { src, alt, caption, detail, sizes, widths, pending = false } = Astro.props;
---

<figure class="evidence-figure" data-evidence-figure>
  <Picture
    src={src}
    alt={alt}
    formats={["avif", "webp"]}
    widths={widths}
    sizes={sizes}
    loading="lazy"
    class="evidence-figure__image"
  />
  <figcaption>
    <span>{caption}</span>
    <span class:list={{ "evidence-figure__detail--pending": pending }}>{detail}</span>
  </figcaption>
</figure>

<style>
  .evidence-figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }

  .evidence-figure :global(picture),
  .evidence-figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--color-ash);
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    line-height: 1.5;
    text-transform: uppercase;
  }

  figcaption span:last-child {
    color: var(--color-graphite);
  }

  figcaption .evidence-figure__detail--pending {
    color: var(--color-electric);
  }
</style>

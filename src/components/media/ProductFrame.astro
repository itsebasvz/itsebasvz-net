---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  chromeLabel?: string;
  accent?: "neutral" | "electric" | "signal";
  phone?: boolean;
  loading?: "eager" | "lazy";
}

const {
  src,
  alt,
  sizes,
  chromeLabel,
  accent = "neutral",
  phone = false,
  loading = "lazy"
} = Astro.props;

const candidateWidths = [195, 320, 480, 640, 960, 1440, 1917];
const widths = candidateWidths.filter((width) => width <= src.width);
---

<figure class:list={["product-frame", { "product-frame--phone": phone }]}>
  {
    chromeLabel && (
      <div class="product-frame__chrome" aria-hidden="true">
        <span class:list={["product-frame__dot", `product-frame__dot--${accent}`]} />
        <span class="product-frame__dot" />
        <span class="product-frame__dot" />
        <span class="product-frame__label">{chromeLabel}</span>
      </div>
    )
  }
  <Picture
    src={src}
    alt={alt}
    formats={["avif"]}
    fallbackFormat="webp"
    widths={widths}
    sizes={sizes}
    loading={loading}
    class="product-frame__image"
  />
</figure>

<style>
  .product-frame {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--rule-visible);
    background: var(--color-frame);
  }

  .product-frame--phone {
    border-color: rgb(113 116 122 / 34%);
    border-radius: var(--radius-device);
  }

  .product-frame__chrome {
    display: flex;
    min-height: 34px;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border-bottom: 1px solid rgb(113 116 122 / 22%);
  }

  .product-frame__dot {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: var(--radius-pill);
    background: rgb(113 116 122 / 40%);
  }

  .product-frame__dot--neutral {
    background: rgb(113 116 122 / 60%);
  }

  .product-frame__dot--electric {
    background: var(--color-electric);
  }

  .product-frame__dot--signal {
    background: var(--color-signal);
  }

  .product-frame__label {
    min-width: 0;
    margin-left: 5px;
    overflow: hidden;
    color: var(--color-graphite);
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-frame :global(picture),
  .product-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>

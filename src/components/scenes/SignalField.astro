---
import { getDictionary } from "../../i18n";
import type { Locale } from "../../i18n";
import { media } from "../../data/media";
import SceneHeader from "../chrome/SceneHeader.astro";
import MediaPlate from "../media/MediaPlate.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getDictionary(locale).home.signalField;
const total = String(copy.modules.length).padStart(2, "0");
---

<section id="senales" class="signal-field" data-scene="02">
  <div class="content-frame">
    <SceneHeader number={2} label={copy.sceneLabel} />

    <div class="signal-field__sequence" data-signal-sequence>
      <div class="signal-field__aside">
        <p class="signal-field__counter" aria-hidden="true" data-signal-aside>
          <span class="signal-field__counter-value"
            ><span>0</span><span class="signal-field__digit" data-signal-digit>1</span></span
          >
          <span class="signal-field__counter-total">/ {total}</span>
        </p>
        <h2 class="signal-field__claim" data-signal-aside>{copy.thesis}</h2>

        <div class="signal-field__portrait" data-signal-aside>
          <div class="signal-field__photo" data-signal-photo>
            <MediaPlate
              src={media["signal-wall-08-crop"]}
              alt={copy.secondPhoto.alt}
              caption={copy.secondPhoto.caption}
              sizes="(min-width: 1100px) 520px, (min-width: 720px) 42vw, calc(100vw - 40px)"
              widths={[320, 480, 640, 880, 936]}
            />
          </div>
          <div class="signal-field__photo" data-signal-photo>
            <MediaPlate
              src={media["signal-texture-14-crop"]}
              alt={copy.firstPhoto.alt}
              caption={copy.firstPhoto.caption}
              sizes="(min-width: 1100px) 520px, (min-width: 720px) 42vw, calc(100vw - 40px)"
              widths={[320, 480, 640, 880, 1037]}
            />
          </div>
        </div>
      </div>

      <ol class="signal-field__steps">
        {
          copy.modules.map((module, index) => (
            <li class="signal-step" data-signal-step>
              <span class="signal-step__number">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="signal-step__title">{module.title}</h3>
              <span class="signal-step__translation">{module.translation}</span>
              <p class="signal-step__description">{module.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import type { SignalFieldTargets } from "../../scripts/motion/signal-field";

  const sequence = document.querySelector<HTMLElement>("[data-signal-sequence]");
  const digit = sequence?.querySelector<HTMLElement>("[data-signal-digit]");

  if (sequence && digit) {
    const targets: SignalFieldTargets = {
      sequence,
      digit,
      aside: [...sequence.querySelectorAll<HTMLElement>("[data-signal-aside]")],
      steps: [...sequence.querySelectorAll<HTMLElement>("[data-signal-step]")],
      photos: [...sequence.querySelectorAll<HTMLElement>("[data-signal-photo]")]
    };

    // GSAP is the heaviest thing on the page after the fox, and this scene sits
    // one screen down. Loading it as the sequence approaches keeps it off the
    // hero's critical path without ever showing an unanimated first step.
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void import("../../scripts/motion/signal-field").then(({ createSignalField }) => {
          createSignalField(targets);
        });
      },
      { rootMargin: "400px 0px" }
    );
    observer.observe(sequence);
  }
</script>

<style>
  .signal-field {
    padding-block: var(--scene-space);
    background: linear-gradient(180deg, var(--color-void) 0%, var(--color-sticker) 14%);
  }

  /* The aside is a grid item, so its sticky range is the full height of the
     steps column beside it. */
  .signal-field__sequence {
    /* Between the claim and the plate, and between the plate and its caption's
       breathing room. One value so the column reads as evenly set. */
    --aside-gap: clamp(20px, 3vh, 36px);
    /* One slab of scroll per step. The aside borrows the same measure, which is
       what keeps the two columns on a shared centre line. */
    --step-block: 42svh;

    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(32px, 6vw, 96px);
  }

  /*
   * Anchored to the top of the frame, under the sticky site header, and holding
   * the plate that shares the column with it.
   *
   * The counter used to be stuck at the offset that centres a step, so it and
   * the active title shared a baseline. Sharing the column with a photograph
   * costs that alignment: the type has to start at the top or there is nowhere
   * for the plate to go. The counter still ticks with the steps, it just no
   * longer lines up with one.
   */
  .signal-field__aside {
    position: sticky;
    top: calc(var(--header-height) + clamp(20px, 4vh, 48px));
    display: flex;
    /* Without this the grid stretches the aside over the whole row, and a
       sticky box as tall as its containing block has no travel left to stick
       with — it just scrolls. */
    align-self: start;
    /* Bounded so the whole column always fits one screen. A sticky box taller
       than the viewport pins its top edge and hides its own bottom, which would
       put the plate's caption out of sight for the entire scene. */
    max-block-size: calc(100svh - var(--header-height) - clamp(52px, 10vh, 116px));
    flex-direction: column;
    gap: var(--aside-gap);
  }

  .signal-field__counter {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0;
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: var(--font-size-display-lg);
    font-weight: 500;
    letter-spacing: var(--tracking-display-lg);
    line-height: 1;
  }

  /* Tabular figures reserve their own width, so the tick never nudges layout. */
  .signal-field__counter-value {
    display: inline-flex;
    font-variant-numeric: tabular-nums;
  }

  /* Inline boxes ignore transforms, and the digit slides as it swaps. */
  .signal-field__digit {
    display: inline-block;
  }

  .signal-field__counter-total {
    color: var(--color-graphite);
    font-size: var(--font-size-label-lg);
    letter-spacing: var(--tracking-label-lg);
  }

  .signal-field__claim {
    max-width: 16ch;
    font-size: var(--font-size-headline-lg);
    letter-spacing: var(--tracking-headline);
    line-height: var(--line-headline);
  }

  /* Takes whatever the counter and the claim leave over. */
  .signal-field__portrait {
    display: grid;
    /* A flex item never shrinks below its content size without this, and the
       content here is a photograph taller than the box. */
    min-block-size: 0;
    flex: 1;
  }

  /* Both plates share one cell, so the handover is a dissolve in place rather
     than a change of layout. The first paints over the second, and fading it
     out is what reveals the one underneath — the second never leaves full
     opacity, because two plates crossing at 50% would let a quarter of the
     background through and read as a dip to black. */
  .signal-field__photo {
    min-block-size: 0;
    grid-area: 1 / 1;
  }

  .signal-field__photo:first-child {
    z-index: 1;
  }

  /* The photographs can share a cell because each one is opaque and hides the
     other. Their captions cannot: type sits on nothing, so both would print in
     the same place. The second label waits for the handover to bring it in —
     and with no JavaScript at all that leaves exactly one photograph and the
     one label that belongs to it, which is the honest static reading of the
     column rather than a blank. */
  .signal-field__photo:not(:first-child) :global(.media-plate__caption) {
    opacity: 0;
  }

  /* The plate is 3:4 and at full column width it is taller than most screens,
     so here it is driven by its height and the width follows the ratio. Both
     photographs are exactly 3:4, so they draw at the same size and the swap
     does not move a pixel. */
  /* The height has to be definite at every link of the chain or the percentage
     below has nothing to resolve against and the image falls back to its
     intrinsic size — which is how the caption ends up outside the column. */
  .signal-field__photo :global(.media-plate) {
    min-block-size: 0;
    block-size: 100%;
  }

  .signal-field__photo :global(picture) {
    display: flex;
    min-block-size: 0;
    flex: 1;
  }

  .signal-field__photo :global(.media-plate__image) {
    /* contain is the guard: in a column wide enough for max-inline-size to bite,
       the height would otherwise be scaled away and the photograph stretched. */
    max-inline-size: 100%;
    block-size: 100%;
    inline-size: auto;
    object-fit: contain;
    object-position: left top;
  }

  .signal-field__steps {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* Each step owns a slab of scroll and centres its own content, so the
     element's midpoint, the snap point and the trigger's `center center` all
     describe the same line. */
  .signal-step {
    display: flex;
    min-height: var(--step-block);
    flex-direction: column;
    justify-content: center;
    scroll-snap-align: center;
  }

  .signal-step__number {
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
  }

  .signal-step__title {
    margin-block: var(--space-3) var(--space-2);
    font-size: var(--font-size-display-lg);
    font-weight: 600;
    letter-spacing: var(--tracking-display-lg);
    line-height: var(--line-display-lg);
  }

  .signal-step__translation {
    color: var(--color-graphite);
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .signal-step__description {
    max-width: 34ch;
    margin-top: var(--space-5);
    color: var(--color-ash);
    font-size: var(--font-size-body-lg);
    line-height: var(--line-body);
  }

  /*
   * The two configurations where the column stops being a travelling companion:
   * narrow enough that it becomes a header, or motion turned off, where there is
   * no scroll to hand one plate over to the other. Either way the aside gives up
   * its stickiness and its height ceiling, and the plates unstack into two
   * pictures in reading order — 08 then 14, the order they carry in the markup.
   */
  @media (max-width: 900px), (prefers-reduced-motion: reduce) {
    .signal-field__aside {
      position: static;
      max-block-size: none;
    }

    .signal-field__portrait {
      display: flex;
      flex-direction: column;
      flex: none;
      gap: var(--aside-gap);
    }

    .signal-field__photo :global(.media-plate) {
      block-size: auto;
    }

    /* Unstacked, each label is under its own photograph again. */
    .signal-field__photo:not(:first-child) :global(.media-plate__caption) {
      opacity: 1;
    }

    .signal-field__photo :global(picture) {
      display: block;
      flex: none;
    }

    .signal-field__photo :global(.media-plate__image) {
      block-size: auto;
      inline-size: 100%;
    }
  }

  @media (max-width: 900px) {
    .signal-field__sequence {
      --step-block: 34svh;

      grid-template-columns: 1fr;
      gap: clamp(24px, 5vw, 48px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Without dimming there is no reason to spend two viewports on five items;
       the list collapses to ordinary reading length. */
    .signal-step {
      min-height: 0;
      padding-block: clamp(20px, 4vh, 44px);
      scroll-snap-align: none;
    }
  }
</style>
